<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permesso per le notifiche (richiesto da Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- lets the notification ring turn the screen on over the lock screen -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    
    <!-- Permesso per la vibrazione (richiesto per haptic feedback) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Riavvia il timeout dello schermo dopo un tocco sulla tastiera -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- Permesso per il riconoscimento vocale -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    
    <!-- Permesso per l'accesso a Internet (richiesto per il controllo aggiornamenti) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lettura delle informazioni del Clicks Power Keyboard tramite BLE GATT -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Permesso per mostrare finestre overlay (per debug trackpad) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Embedded wireless-ADB broker. WRITE_SECURE_SETTINGS can only be granted over adb. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />


    <!-- write Settings.System (Fn -> Ctrl on the Titan 2 Elite). The user grants it on the
         "Modify system settings" screen; without it the paired broker is used instead. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <!-- Query per vedere tutte le app installate che possono essere avviate -->
    <queries>
        <package android:name="org.futo.voiceinput" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        
        <!-- Query per vedere i launcher -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>

        <!-- Optional QuickLauncher backend: Niagara Launcher search deep link -->
        <package android:name="bitpit.launcher" />
        <package android:name="net.dinglisch.android.taskerm" />
        <package android:name="io.homeassistant.companion.android" />
        <package android:name="com.clicks.companionapp" />

        <!-- the bloat catalog's packages (BloatCatalog.kt), so the app can read back through
             PackageManager whether a disable/uninstall/restore really happened. Kept in step by
             BloatCatalogTest. -->
        <package android:name="com.bhpme.AgingTest" />
        <package android:name="com.agui.factorytest" />
        <package android:name="com.agui.calibration" />
        <package android:name="com.agui.app.memtester" />
        <package android:name="com.agui.app.imei" />
        <package android:name="com.agui.batterystatsdumper" />
        <package android:name="com.agui.app.apninfocollector" />
        <package android:name="com.debug.loggerui" />
        <package android:name="com.devices116" />
        <package android:name="com.swatch.gps" />
        <package android:name="com.example.feedback" />
        <package android:name="com.agui.systemmanager" />
        <package android:name="com.agui.aguigrabageclear" />
        <package android:name="com.agui.frozen" />
        <package android:name="com.agui.appblock" />
        <package android:name="com.agui.applock" />
        <package android:name="com.agui.privatespace" />
        <package android:name="com.agui.studentmodel" />
        <package android:name="com.agui.game" />
        <package android:name="com.agui.toolbox" />
        <package android:name="com.agui.bedtimesetting" />
        <package android:name="com.agui.callrecord" />
        <package android:name="com.agui.providers.pedometer" />
        <package android:name="com.agui.rotationcontrol" />
        <package android:name="com.agold.autopoweronoff" />
        <package android:name="com.agui.nfc" />
        <package android:name="com.agold.cyclocomputer" />
        <package android:name="com.tiqiaa.icontrol" />
    </queries>

    <application
        android:name=".PlektraApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="${appIcon}"
        android:label="${appLabel}"
        android:roundIcon="${appRoundIcon}"
        android:supportsRtl="true"
        android:theme="@style/Theme.Plektra">
        <activity
            android:name=".TutorialActivity"
            android:exported="false"
            android:label="${appLabel}"
            android:theme="@style/Theme.Plektra" />
        
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:label="${appLabel}"
            android:theme="@style/Theme.Plektra" />

        <activity-alias
            android:name=".OrangeLauncherAlias"
            android:enabled="${closedOrangeLauncherEnabled}"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="${appLabel}"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".OpenOrangeLauncherAlias"
            android:enabled="${openOrangeLauncherEnabled}"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_open"
            android:label="${appLabel}"
            android:roundIcon="@mipmap/ic_launcher_open_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".BlueLauncherAlias"
            android:enabled="${closedBlueLauncherEnabled}"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_nightly"
            android:label="${appLabel}"
            android:roundIcon="@mipmap/ic_launcher_nightly_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".OpenBlueLauncherAlias"
            android:enabled="${openBlueLauncherEnabled}"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_nightly_open"
            android:label="${appLabel}"
            android:roundIcon="@mipmap/ic_launcher_nightly_open_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".SoftwareKeyboardModeActionActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:finishOnTaskLaunch="true"
            android:label="@string/software_keyboard_mode_toggle_shortcut_short"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="rocks.pkb.plektra.action.TOGGLE_SOFTWARE_KEYBOARD_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        
        <!-- Activity per la personalizzazione SYM -->
        <activity
            android:name=".SymCustomizationActivity"
            android:exported="false"
            android:label="@string/sym_customize_title"
            android:theme="@style/Theme.Plektra" />
        
        <activity android:name=".KeyboardLayoutActivity" android:exported="false" android:theme="@style/Theme.Plektra" />
        <activity android:name=".NotesActivity" android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:label="@string/notes_title" android:theme="@style/Theme.Plektra" />

        <activity android:name=".CornerCalibrationActivity" android:exported="false"
            android:label="Displaykurve kalibrieren" android:theme="@style/Theme.Plektra" />

        <!-- Activity per le impostazioni -->
        <activity
            android:name=".SettingsActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:label="@string/settings_title"
            android:theme="@style/Theme.Plektra">
            <!-- Settings links only navigate and highlight; they never change values.
                 Keep the plektra scheme and verified pkb.rocks links.
                 Future: if multiple Stable/Nightly or Plektra/Plektra apps are installed,
                 consider an in-app choice with explicit forwarding to the selected package.
                 Verified overlapping App Links do not guarantee an Android chooser. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="plektra"
                    android:host="setting" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="pkb.rocks"
                    android:pathPrefix="/settings/" />
            </intent-filter>
        </activity>
        
        <!-- Activity per gestire le lingue degli input method subtypes -->
        <activity
            android:name=".LanguagesActivity"
            android:exported="false"
            android:label="@string/languages_title"
            android:theme="@style/Theme.Plektra" />
        
        <activity
            android:name=".dictionaries.InstalledDictionariesActivity"
            android:exported="false"
            android:label="@string/installed_dictionaries_title"
            android:theme="@style/Theme.Plektra.InstalledDictionariesAnimation" />

        <activity
            android:name=".layout.OnlineLayoutsActivity"
            android:exported="false"
            android:label="@string/online_layouts_title"
            android:theme="@style/Theme.Plektra" />

        <!-- Activity for trackpad debug -->
        <activity
            android:name=".TrackpadDebugActivity"
            android:exported="false"
            android:label="@string/trackpad_debug_title"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance" />

        <!-- Servizio di immissione per tastiera fisica -->
        <service
            android:name=".inputmethod.PhysicalKeyboardInputMethodService"
            android:label="${imeLabel}"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- notification ring around the camera hole while the screen is otherwise off.
             The listener is bound by the system once notification access is granted; the activity is
             what the system launches for the ring's full-screen notification. -->
        <service
            android:name=".ring.NotificationRingListener"
            android:exported="true"
            android:label="@string/ring_title"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <activity
            android:name=".ring.NotificationRingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity="rocks.pkb.plektra.ring"
            android:theme="@style/Theme.Plektra.Ring" />
        <activity
            android:name=".ring.RingAdjustActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Plektra.Ring" />

        <service
            android:name=".inputmethod.ClicksLauncherButtonAccessibilityService"
            android:exported="true"
            android:label="@string/clicks_launcher_interception_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/clicks_launcher_button_accessibility_service" />
        </service>

        <!-- Attività helper per richiedere il permesso del microfono -->
        <activity
            android:name=".inputmethod.PermissionRequestActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="" />
        
        <!-- Attività per assegnare scorciatoie del launcher -->
        <activity
            android:name=".inputmethod.LauncherShortcutAssignmentActivity"
            android:theme="@style/Theme.Plektra.OverlayDialog"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:noHistory="true"
            android:finishOnTaskLaunch="true" />

        <activity
            android:name=".inputmethod.AddSubstitutionActivity"
            android:theme="@style/Theme.Plektra.OverlayDialog"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:noHistory="true"
            android:finishOnTaskLaunch="true" />

        <activity
            android:name=".inputmethod.QuickLauncherActivity"
            android:theme="@style/Theme.Plektra.QuickLauncherOverlay"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:noHistory="true"
            android:finishOnTaskLaunch="true" />

        <!-- vendored Shizuku ADB pairing foreground service -->
        <service
            android:name="moe.shizuku.manager.adb.AdbPairingService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Quick Settings tile for the Titan 2 Elite keyboard backlight -->
        <service
            android:name="rocks.pkb.plektra.KeyboardBacklightTileService"
            android:exported="true"
            android:icon="@drawable/ic_lightbulb_24"
            android:label="@string/backlight_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Shizuku provider -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>

</manifest>
