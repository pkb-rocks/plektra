{
  "name": "Uyghur — ئۇيغۇرچە",
  "description": "Uyghur PC layout. Q25 shortcuts: Shift+M ئ, Alt+N ،, Alt+V ؟, Alt+J ؛. Other Alt keys keep the device's numbers and symbols.",
  "mappings": {
    "KEYCODE_Q": { "lowercase": "چ", "uppercase": "چ" },
    "KEYCODE_W": { "lowercase": "ۋ", "uppercase": "ۋ" },
    "KEYCODE_E": { "lowercase": "ې", "uppercase": "ې" },
    "KEYCODE_R": { "lowercase": "ر", "uppercase": "ر" },
    "KEYCODE_T": { "lowercase": "ت", "uppercase": "ت" },
    "KEYCODE_Y": { "lowercase": "ي", "uppercase": "ي" },
    "KEYCODE_U": { "lowercase": "ۇ", "uppercase": "ۇ" },
    "KEYCODE_I": { "lowercase": "ڭ", "uppercase": "ڭ" },
    "KEYCODE_O": { "lowercase": "و", "uppercase": "و" },
    "KEYCODE_P": { "lowercase": "پ", "uppercase": "پ" },
    "KEYCODE_A": { "lowercase": "ھ", "uppercase": "ھ" },
    "KEYCODE_S": { "lowercase": "س", "uppercase": "س" },
    "KEYCODE_D": { "lowercase": "د", "uppercase": "ژ" },
    "KEYCODE_F": { "lowercase": "ا", "uppercase": "ف" },
    "KEYCODE_G": { "lowercase": "ە", "uppercase": "گ" },
    "KEYCODE_H": { "lowercase": "ى", "uppercase": "خ" },
    "KEYCODE_J": { "lowercase": "ق", "uppercase": "ج", "alt": "؛" },
    "KEYCODE_K": { "lowercase": "ك", "uppercase": "ۆ" },
    "KEYCODE_L": { "lowercase": "ل", "uppercase": "لا" },
    "KEYCODE_Z": { "lowercase": "ز", "uppercase": "ز" },
    "KEYCODE_X": { "lowercase": "ش", "uppercase": "ش" },
    "KEYCODE_C": { "lowercase": "غ", "uppercase": "غ" },
    "KEYCODE_V": { "lowercase": "ۈ", "uppercase": "ۈ", "alt": "؟" },
    "KEYCODE_B": { "lowercase": "ب", "uppercase": "ب" },
    "KEYCODE_N": { "lowercase": "ن", "uppercase": "ن", "alt": "،" },
    "KEYCODE_M": { "lowercase": "م", "uppercase": "ئ" },
    "KEYCODE_SLASH": { "lowercase": "ئ", "uppercase": "؟" },
    "KEYCODE_COMMA": { "lowercase": "،", "uppercase": ">" },
    "KEYCODE_PERIOD": { "lowercase": ".", "uppercase": "<" },
    "KEYCODE_SEMICOLON": { "lowercase": "؛", "uppercase": ":" },
    "KEYCODE_1": { "lowercase": "1", "uppercase": "!" },
    "KEYCODE_MINUS": { "lowercase": "-", "uppercase": "_" }
  }
}
